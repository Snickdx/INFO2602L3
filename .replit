modules = ["python-3.10", "nix"]

hidden = [".pythonlibs"]
run = "uvicorn app:asgi_app --host 0.0.0.0 --port 8080 --reload"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "uvicorn app:asgi_app --host 0.0.0.0 --port 8080"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8080
externalPort = 80
